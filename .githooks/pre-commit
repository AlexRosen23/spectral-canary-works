#!/bin/sh
# Secret guard: gitleaks scans the staged changes before every commit.
# Findings are redacted, so no secret value is ever printed.
# Enabled per clone with: git config core.hooksPath .githooks
GITLEAKS=$(command -v gitleaks 2>/dev/null || echo "$HOME/.local/bin/gitleaks")
if [ ! -x "$GITLEAKS" ]; then
  echo "pre-commit: gitleaks is not installed, so the commit is blocked (see CONTRIBUTING.md)." >&2
  exit 1
fi
if ! "$GITLEAKS" git --pre-commit --staged --redact --no-banner --log-level warn .; then
  echo "pre-commit: possible secret in the staged changes (values redacted above). Commit blocked." >&2
  echo "            Remove it; if it was real, rotate it. Never bypass with --no-verify." >&2
  exit 1
fi
