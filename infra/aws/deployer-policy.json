{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Ec2NetworkAndInstance", "Effect": "Allow", "Action": [
      "ec2:Describe*", "ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute", "ec2:CreateSubnet", "ec2:DeleteSubnet",
      "ec2:ModifySubnetAttribute", "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway", "ec2:AttachInternetGateway",
      "ec2:DetachInternetGateway", "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute",
      "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup",
      "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupIngress",
      "ec2:RevokeSecurityGroupEgress", "ec2:RunInstances", "ec2:TerminateInstances", "ec2:CreateTags", "ec2:DeleteTags",
      "ec2:ModifyInstanceMetadataOptions"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}},
    {"Sid": "PassOnlyTheGatewayRole", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/scw-gateway-instance"},
    {"Sid": "ManageOnlyTheGatewayRole", "Effect": "Allow", "Action": [
      "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
      "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies",
      "iam:ListInstanceProfilesForRole", "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile",
      "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile"],
      "Resource": ["arn:aws:iam::*:role/scw-gateway-instance", "arn:aws:iam::*:instance-profile/scw-gateway-instance"]},
    {"Sid": "EcrThisRepo", "Effect": "Allow", "Action": ["ecr:*"],
      "Resource": "arn:aws:ecr:us-east-2:*:repository/spectral-canary-works"},
    {"Sid": "EcrAuth", "Effect": "Allow", "Action": ["ecr:GetAuthorizationToken", "ecr:CreateRepository", "ecr:DescribeRepositories"], "Resource": "*"},
    {"Sid": "BudgetThisProject", "Effect": "Allow", "Action": ["budgets:ViewBudget", "budgets:ModifyBudget", "budgets:ListTagsForResource", "budgets:TagResource"],
      "Resource": "arn:aws:budgets::*:budget/spectral-canary-works-monthly"},
    {"Sid": "ReadAmiParameter", "Effect": "Allow", "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-2::parameter/aws/service/ami-amazon-linux-latest/*"},
    {"Sid": "Identity", "Effect": "Allow", "Action": ["sts:GetCallerIdentity"], "Resource": "*"}
  ]
}
